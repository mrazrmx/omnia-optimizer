<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BaseOmniaTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/omnia_bg</item>
        <item name="android:statusBarColor">@color/omnia_bg</item>
        <item name="android:navigationBarColor">@color/omnia_nav_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/omnia_primary</item>
        <item name="android:colorPrimary">@color/omnia_primary</item>
        <item name="android:textColorPrimary">@color/omnia_text_primary</item>
        <item name="android:textColorSecondary">@color/omnia_text_secondary</item>
    </style>

    <style name="OmniaAppTheme" parent="BaseOmniaTheme" />
</resources>
